class TestReadmeMarkdownQuality:
    """Tests for markdown formatting quality."""
    
    @pytest.fixture
    def readme_content(self):
        """Fixture to load README content."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding='utf-8')
    
    def test_header_hierarchy_valid(self, readme_content):
        """Test that markdown headers follow proper hierarchy (no skipping levels)."""
        lines = readme_content.split('\n')
        prev_level = 0
        for line_num, line in enumerate(lines, 1):
            if line.startswith('#') and not line.startswith('# '):
                # Skip lines that start with # but aren't headers (like comments)
                continue
            if line.startswith('# '):
                level = len(line.split()[0])  # Count # characters
                if prev_level > 0 and level > 1:
                    assert level <= prev_level + 1, \
                        f"Header hierarchy error at line {line_num}: {line}"
                prev_level = level
    
    def test_no_broken_internal_links(self, readme_content):
        """Test that internal markdown links are properly formatted."""
        # Check for markdown links [](url)
        links = re.findall(r'\[([^\]]+)\]\(([^)]+)\)', readme_content)
        for text, url in links:
            if not url.startswith(('http', '#', 'mailto:')):
                # Internal file reference
                assert not url.endswith('.md') or url == 'README.md', \
                    f"Link to {url} should reference actual project files"


@pytest.mark.integration
class TestReadmeIntegration:
    """Integration tests verifying README matches actual project state."""
    
    @pytest.fixture
    def readme_content(self):
        """Fixture to load README content."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding='utf-8')
    
    def test_referenced_python_files_exist(self, readme_content):
        """Test that Python files mentioned in README exist."""
        py_files = re.findall(r'`(\w+\.py)`', readme_content)
        for file in set(py_files):
            if file in ['train_model.py', 'app.py']:
                file_path = Path(file)
                if not file_path.exists():
                    pytest.skip(f"{file} not found in repository (may be expected in full project)")
    
    def test_dataset_file_referenced(self, readme_content):
        """Test that churn.csv is referenced in README."""
        assert "churn.csv" in readme_content, \
            "README should reference the dataset file churn.csv"
    
    def test_requirements_file_referenced(self, readme_content):
        """Test that requirements.txt is referenced."""
        assert "requirements.txt" in readme_content, \
            "README should reference requirements.txt for dependencies"
