class TestReadmeCodeBlocks:
    """Tests to validate code blocks in README are executable."""
    
    @pytest.fixture
    def readme_content(self):
        """Load README.md content."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding='utf-8')
    
    def extract_bash_commands(self, readme_content):
        """Extract bash commands from markdown code blocks."""
        # Find all bash code blocks
        pattern = r'```bash\n(.*?)\n```'
        matches = re.findall(pattern, readme_content, re.DOTALL)
        commands = []
        for match in matches:
            # Split by newlines and filter empty lines
            lines = [line.strip() for line in match.split('\n') if line.strip()]
            commands.extend(lines)
        return commands
    
    def test_git_clone_command_format(self, readme_content):
        """Test that git clone command has correct URL format."""
        commands = self.extract_bash_commands(readme_content)
        clone_commands = [cmd for cmd in commands if 'git clone' in cmd]
        assert len(clone_commands) > 0, "Should have git clone command"
        for cmd in clone_commands:
            assert "https://github.com/rahulmahasetha/churn-prediction.git" in cmd
    
    def test_pip_install_command(self, readme_content):
        """Test that pip install command references requirements.txt."""
        commands = self.extract_bash_commands(readme_content)
        install_commands = [cmd for cmd in commands if 'pip install' in cmd]
        assert any('requirements.txt' in cmd for cmd in install_commands), \
            "Should have pip install -r requirements.txt command"
    
    def test_python_train_command(self, readme_content):
        """Test that training command is documented."""
        commands = self.extract_bash_commands(readme_content)
        assert any('python train_model.py' in cmd for cmd in commands), \
            "Should have python train_model.py command"
    
    def test_streamlit_run_command(self, readme_content):
        """Test that streamlit run command is documented."""
        commands = self.extract_bash_commands(readme_content)
        assert any('streamlit run app.py' in cmd for cmd in commands), \
            "Should have streamlit run app.py command"


