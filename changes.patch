class TestReadmeContentQuality:
    """Tests for README content quality and completeness."""
    
    @pytest.fixture
    def readme_content(self):
        """Load README.md content."""
        readme_path = Path("README.md")
        if not readme_path.exists():
            pytest.skip("README.md not found")
        return readme_path.read_text(encoding='utf-8')
    
    def test_no_placeholder_text(self, readme_content):
        """Test that README doesn't contain placeholder text like 'TODO' or 'FIXME'."""
        placeholders = ['TODO', 'FIXME', 'XXX', 'INSERT', 'YOUR_API_KEY']
        for placeholder in placeholders:
            assert placeholder not in readme_content, \
                f"README should not contain placeholder: {placeholder}"
    
    def test_all_sections_have_content(self, readme_content):
        """Test that sections don't end immediately after header."""
        lines = readme_content.split('\n')
        for i, line in enumerate(lines):
            if line.startswith('## '):
                # Check that next non-empty line exists and is not another header
                j = i + 1
                while j < len(lines) and not lines[j].strip():
                    j += 1
                if j < len(lines):
                    next_line = lines[j]
                    assert not next_line.startswith('##'), \
                        f"Section '{line}' appears to be empty"
    
    def test_markdown_headers_hierarchy(self, readme_content):
        """Test that markdown headers follow proper hierarchy (no skipping levels)."""
        lines = readme_content.split('\n')
        prev_level = 0
        for line in lines:
            if line.startswith('#'):
                level = len(line) - len(line.lstrip('#'))
                # Should not skip levels (e.g., # to ###)
                if prev_level > 0:
                    assert level <= prev_level + 1, \
                        f"Header hierarchy skip detected: {line}"
                prev_level = level


