class TestIntegration:
    """Integration tests to verify end-to-end functionality."""
    
    @pytest.mark.skipif(not os.path.exists("churn.csv"), reason="Dataset not available")
    def test_training_pipeline_runs(self):
        """Integration test: Verify training script runs successfully."""
        if not os.path.exists("train_model.py"):
            pytest.skip("train_model.py not found")
        
        # Run training script
        result = subprocess.run(
            [sys.executable, "train_model.py"],
            capture_output=True,
            text=True,
            timeout=120
        )
        
        assert result.returncode == 0, \
            f"Training script failed with error: {result.stderr}"
        
        # Check that models directory and files were created
        assert os.path.exists("models"), "Training should create models directory"
        assert any(f.endswith('.pkl') for f in os.listdir("models")), \
            "Training should create .pkl model files"
    
    def test_streamlit_app_syntax(self):
        """Test that Streamlit app has valid Python syntax."""
        if not os.path.exists("app.py"):
            pytest.skip("app.py not found")
        
        result = subprocess.run(
            [sys.executable, "-m", "py_compile", "app.py"],
            capture_output=True,
            text=True
        )
        
        assert result.returncode == 0, \
            f"app.py has syntax errors: {result.stderr}"


